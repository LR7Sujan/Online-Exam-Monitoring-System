# ============================================================================
# ProctorIQ Isolated Test Environment Example Configuration (Server)
# ============================================================================

PORT=4001
NODE_ENV=test
CLIENT_ORIGIN=http://localhost:5174

# Isolated Test Database
# DATABASE_URL=mysql://root:proctoriq_root@127.0.0.1:3306/exam_monitoring_test?ssl=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=proctoriq_root
DB_NAME=exam_monitoring_test
DB_CONNECTION_LIMIT=30
DB_SSL=false

# Test JWT Secret
JWT_SECRET=isolated-test-proctoriq-secret-key-min-64-characters-security-guard
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=8

# Client Settings (Vite Test Server)
VITE_PORT=5174
VITE_API_URL=http://localhost:4001/api
VITE_SOCKET_URL=http://localhost:4001
VITE_BACKEND_ORIGIN=http://localhost:4001

# Isolated Test Uploads & Paths
DB_SCHEMA_PATH=./db/schema.sql
DB_MIGRATIONS_DIR=./db/migrations
DB_SEED_PATH=./db/seed_test.sql
UPLOADS_DIR=./server/uploads-test
