{
  "name": "proctoriq-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ProctorIQ thin REST + Socket.IO backend over MySQL 8.0+ DBMS logic",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "dev:api": "tsx watch src/dev.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:test": "tsx --env-file=.env.test src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "db:init": "tsx src/scripts/migrate.ts migrate && tsx src/scripts/migrate.ts seed",
    "db:migrate": "tsx src/scripts/migrate.ts migrate",
    "db:seed": "tsx src/scripts/migrate.ts seed",
    "db:reset": "tsx src/scripts/migrate.ts reset",
    "db:verify": "tsx src/scripts/verifyDbCapabilities.ts",
    "db:migrate:data": "tsx src/scripts/migrateProductionData.ts",
    "db:test:create": "tsx --env-file=.env.test src/scripts/initTestDb.ts --create",
    "db:test:reset": "tsx --env-file=.env.test src/scripts/initTestDb.ts --reset",
    "simulate": "tsx src/scripts/simulate.ts",
    "test:vitest": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run --no-file-parallelism",
    "test:db": "tsx --env-file=.env.test ../db/tests/run_all_tests.ts",
    "test": "tsx --env-file=.env.test --test \"tests/*.unit.test.ts\" \"tests/*.integration.test.ts\" && node --env-file=.env.test ./node_modules/vitest/vitest.mjs run --no-file-parallelism"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/s3-request-presigner": "^3.1177.0",
    "@vercel/blob": "^2.9.0",
    "bcrypt": "^5.1.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5",
    "pusher": "^5.3.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "supertest": "^7.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^5.1.0"
  }
}
