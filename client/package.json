    "geist": "^1.9.2",
    "lucide-react": "^0.469.0",
    "pusher-js": "^8.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0",
    "sonner": "^2.0.8",
    "zustand": "^5.0.2"
