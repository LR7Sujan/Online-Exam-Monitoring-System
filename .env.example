# ============================================================================
# ProctorIQ Environment Configuration
# Copy this file to .env (at repo root or server/.env) before starting.
# ============================================================================

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MySQL 8.0+ Connection (Standard parameters or full DATABASE_URL)
# DATABASE_URL=mysql://root:proctoriq_root@127.0.0.1:3306/proctoriq?ssl=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=proctoriq_root
DB_NAME=proctoriq
DB_CONNECTION_LIMIT=3
DB_SSL=false
# DB_SSL_CA=/path/to/ca-cert.pem

# Authentication (change in production!)
JWT_SECRET=replace-with-a-64-char-random-cryptographic-secret-for-proctoriq
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# Client (Vite) - place in client/.env if overriding defaults
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

# Paths (relative to project root)
DB_SCHEMA_PATH=./db/schema.sql
DB_MIGRATIONS_DIR=./db/migrations
DB_SEED_PATH=./db/seed.sql
UPLOADS_DIR=./server/uploads
EXTENSION_GRACE_SECONDS=180
WARNING_GRACE_SECONDS=5

# Realtime Provider ('polling' fallback or 'pusher')
REALTIME_PROVIDER=polling
# Pusher Channels credentials (if REALTIME_PROVIDER=pusher)
# PUSHER_APP_ID=your-pusher-app-id
# PUSHER_KEY=your-pusher-key
# PUSHER_SECRET=your-pusher-secret
# PUSHER_CLUSTER=mt1

# Storage Adapter Configuration
# Provider: 'blob' (Vercel Blob), 's3' (Cloudflare R2 / AWS S3), 'local' (development/test only)
STORAGE_PROVIDER=local
STORAGE_PREFIX=

# Vercel Cron Housekeeping Protection Secret
CRON_SECRET=replace-with-a-random-secret-for-vercel-cron
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# S3_BUCKET=proctoriq-evidence
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_FORCE_PATH_STYLE=true



