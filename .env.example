# ============================================================================
# ProctorIQ Environment Configuration Example
# ============================================================================
# Copy this file to `.env` in the repository root (or set in Vercel Project Settings).
#
# SECURITY NOTICE:
# - Variables WITHOUT the `VITE_` (or `NEXT_PUBLIC_`) prefix are STRICTLY CONFIDENTIAL
#   and only accessible to the Node.js / Serverless API runtime. NEVER commit real secrets!
# - Variables WITH the `VITE_` (or `NEXT_PUBLIC_`) prefix are compiled directly into the
#   client JavaScript bundle and are PUBLICLY VISIBLE in browser network/source tabs.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME (Server-Only Secret)
# ----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
# In local dev: http://localhost:5173. In production Vercel: https://your-domain.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# ----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION - MySQL 8.0+ (Server-Only Secret)
# ----------------------------------------------------------------------------
# Option A: Full Connection String (Standard for hosted cloud providers: Aiven, RDS, PlanetScale)
# DATABASE_URL=mysql://dbuser:dbpassword@cloud-host.example.com:3306/proctoriq?ssl=true

# Option B: Discrete Parameters (Local development or custom setups)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=proctoriq_user
DB_PASSWORD=your_secure_db_password
DB_NAME=proctoriq
# Connection pool limit per serverless instance (1-3 recommended for Vercel functions)
DB_CONNECTION_LIMIT=3
# Set to 'true' when connecting to managed cloud databases requiring TLS
DB_SSL=false
# Optional: path to custom CA certificate file if required by cloud DB provider
# DB_SSL_CA=/path/to/ca-cert.pem

# Paths for schema, migrations, and seed scripts
DB_SCHEMA_PATH=./db/schema.sql
DB_MIGRATIONS_DIR=./db/migrations
DB_SEED_PATH=./db/seed.sql

# ----------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Server-Only Secret)
# ----------------------------------------------------------------------------
# Cryptographically secure random secret (min 64 chars) used to sign user JWTs
JWT_SECRET=replace_with_a_64_character_cryptographically_secure_random_string
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# Server secret pepper (min 32 chars) for HMAC hashing of OTP verification codes
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_PEPPER=replace_with_a_32_character_cryptographically_secure_random_pepper

# Email Service Provider: 'console' (dev default), 'smtp' (production / Gmail / Brevo), 'mock' (tests)
MAIL_PROVIDER=console
MAIL_FROM="ProctorIQ Security <no-reply@proctoriq.io>"
APP_BASE_URL=http://localhost:5173

# SMTP Configuration (Required when MAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_SECURE=false

# ----------------------------------------------------------------------------
# 4. VERCEL CRON & HOUSEKEEPING PROTECTION (Server-Only Secret)
# ----------------------------------------------------------------------------
# Shared secret protecting /api/cron/* endpoints (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=replace_with_a_secure_random_token_for_cron_authorization

# ----------------------------------------------------------------------------
# 5. REALTIME PROVIDER (Server-Only Secret)
# ----------------------------------------------------------------------------
# Choose 'pusher' (recommended for serverless) or 'polling' (zero external dependencies)
REALTIME_PROVIDER=polling

# Pusher Channels credentials (required if REALTIME_PROVIDER=pusher)
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_app_key
PUSHER_SECRET=your_pusher_app_secret
PUSHER_CLUSTER=mt1
PUSHER_USE_TLS=true

# ----------------------------------------------------------------------------
# 6. OBJECT STORAGE ADAPTER (Server-Only Secret)
# ----------------------------------------------------------------------------
# Provider: 'blob' (Vercel Blob), 's3' (Cloudflare R2 / AWS S3), 'local' (dev/test only; blocked in prod)
STORAGE_PROVIDER=local
# Optional storage key namespace prefix (e.g. 'prod/' or 'test/')
STORAGE_PREFIX=

# Vercel Blob credentials (if STORAGE_PROVIDER=blob)
# Automatically populated by Vercel when Blob store is connected
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_read_write_token_here

# AWS S3 or Cloudflare R2 credentials (if STORAGE_PROVIDER=s3)
S3_BUCKET=proctoriq-evidence
S3_REGION=auto
# For Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_s3_or_r2_access_key
S3_SECRET_ACCESS_KEY=your_s3_or_r2_secret_key
S3_FORCE_PATH_STYLE=true

# Development local upload folder (used ONLY when STORAGE_PROVIDER=local)
UPLOADS_DIR=./server/uploads

# ----------------------------------------------------------------------------
# 7. RETENTION & EVIDENCE LIFECYCLE (Server-Only Secret)
# ----------------------------------------------------------------------------
# Automatic retention purge period for webcam recordings (days)
RECORDING_RETENTION_DAYS=30
# Soft warning threshold for storage consumption in admin console (GB)
RECORDING_MAX_STORAGE_GB=5

# ----------------------------------------------------------------------------
# 8. EXAM & PROCTORING INVARIANTS (Server-Only Secret)
# ----------------------------------------------------------------------------
# Grace window (seconds) allowing student to request extra time after regular exam deadline
EXTENSION_GRACE_SECONDS=180
# Minimum delay (seconds) required before issuing consecutive infraction warnings
WARNING_GRACE_SECONDS=5
# Time extension limits:
# - Configured per-exam in MySQL: Exams.max_extension_mins (default: 30 minutes, max: 120 minutes)
# - Maximum extension minutes allowed per exam: 120
# - Exactly 1 active PENDING extension request permitted per candidate session

# ============================================================================
# 9. CLIENT-EXPOSED PUBLIC CONFIGURATION (Vite Frontend Bundle)
# ============================================================================
# NOTE: Any variable starting with VITE_ (or NEXT_PUBLIC_) is EMBEDDED into the browser
# client build. NEVER put passwords, private API secrets, or database credentials here!
# ----------------------------------------------------------------------------
# Base API URL:
# - In local development: http://localhost:4000/api
# - In production Vercel: /api (same-origin relative URL)
VITE_API_URL=/api

# Realtime mode on client ('polling' or 'pusher')
VITE_REALTIME_PROVIDER=polling

# Public Pusher client parameters (only needed if VITE_REALTIME_PROVIDER=pusher)
# Note: PUSHER_SECRET is NEVER placed on the client!
VITE_PUSHER_KEY=your_public_pusher_app_key
VITE_PUSHER_CLUSTER=mt1

# Next.js client equivalents (if embedding in Next.js frontend):
# NEXT_PUBLIC_API_URL=/api
# NEXT_PUBLIC_REALTIME_PROVIDER=polling
# NEXT_PUBLIC_PUSHER_KEY=your_public_pusher_app_key
# NEXT_PUBLIC_PUSHER_CLUSTER=mt1
