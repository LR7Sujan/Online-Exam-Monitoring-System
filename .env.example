# ============================================================================
# ProctorIQ Environment Configuration
# Copy this file to .env (at repo root or server/.env) before starting.
# ============================================================================

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MySQL 8.0+ Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=proctoriq_root
DB_NAME=proctoriq
DB_CONNECTION_LIMIT=10

# Authentication (change in production!)
JWT_SECRET=replace-with-a-64-char-random-cryptographic-secret-for-proctoriq
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# Client (Vite) - place in client/.env if overriding defaults
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

# Paths (relative to project root)
DB_SCHEMA_PATH=./db/schema.sql
DB_MIGRATIONS_DIR=./db/migrations
DB_SEED_PATH=./db/seed.sql
UPLOADS_DIR=./server/uploads
EXTENSION_GRACE_SECONDS=180

